# Copia este archivo como .env y modifica únicamente lo que necesites.

# Raíz principal de datos: resultados, modelos y cachés de Hugging Face/Torch.
# En WSL puede apuntar a una unidad de Windows, por ejemplo /mnt/d/YuE2.
YUE2_STUDIO_HOME=~/YuE2-Studio

# Sobrescrituras opcionales
# YUE2_OUTPUTS_ROOT=~/YuE2-Studio/outputs
# SHEETSAGE2_DIR=~/YuE2-Studio/models/SheetSage2
SHEETSAGE2_PYTHON=~/venvs/sheetsage2/bin/python

# IMPORTANTE: en WSL conserva esta ruta dentro del sistema de archivos Linux.
SHEETSAGE2_WORK_ROOT=~/.cache/yue2-studio/sheetsage2
HF_MODULES_CACHE=~/.cache/huggingface/modules

# YuE2
YUE2_MEMORY_BUDGET_GIB=12
# YUE2_MODEL_ID=m-a-p/YuE2-3B
# YUE2_VAE_ID=m-a-p/YuE2-Vae

# Gradio
YUE2_SERVER_NAME=127.0.0.1
YUE2_SERVER_PORT=7860

# Agent Edit (Ollama o endpoint compatible con OpenAI)
YUE2_AGENT_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
# YUE2_AGENT_MODEL=
